# Base de datos MySQL / MariaDB
#  · En Hostinger (dentro del hosting): usa 127.0.0.1, NO "localhost"
#      DATABASE_URL="mysql://u123456789_arcohoot:CLAVE@127.0.0.1:3306/u123456789_arcohoot"
#  · Desde tu PC contra la base de Hostinger (activa "MySQL remoto" en hPanel): usa el host srvXXX.hstgr.io
#  · Con XAMPP en tu PC: mysql://root:@127.0.0.1:3306/arcohoot
DATABASE_URL="mysql://root:@127.0.0.1:3306/arcohoot"
PORT=3001

# Inicio de sesión con Google (opcional). Créalo en https://console.cloud.google.com/apis/credentials
# Tipo: "ID de cliente de OAuth" → Aplicación web. Orígenes autorizados: http://localhost:5173 y tu dominio
GOOGLE_CLIENT_ID=""
