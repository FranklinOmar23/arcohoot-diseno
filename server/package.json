{
  "name": "arcohoot-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "db:migrar": "node scripts/prisma.mjs migrate deploy",
    "db:setup": "node scripts/prisma.mjs migrate deploy && npm run db:seed",
    "db:nueva-migracion": "node scripts/prisma.mjs migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node scripts/prisma.mjs studio"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "exceljs": "^4.4.0",
    "express": "5.1.0",
    "google-auth-library": "10.9.1",
    "prisma": "6.1.0",
    "socket.io": "^4.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/node": "22.10.2",
    "tsx": "4.21.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
